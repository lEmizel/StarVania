shader_parameter/core_intensity = 3.0
shader_parameter/corona_strength = 0.0
shader_parameter/color_core = Color(1, 0.98, 0.9, 1)
shader_parameter/color_hot = Color(1, 0.85, 0.3, 1)
shader_parameter/color_mid = Color(1, 0.5, 0.1, 1)
