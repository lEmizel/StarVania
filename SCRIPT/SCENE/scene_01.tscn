[sub_resource type="Shader" id="Shader_k1x5j"]
code = "shader_type canvas_item;
render_mode blend_add;

// === PARAMÈTRES ===
uniform float flame_size : hint_range(0.05, 0.5) = 0.2;
uniform float flame_height : hint_range(0.05, 0.4) = 0.18;
uniform float speed : hint_range(0.1, 5.0) = 1.5;
uniform float core_intensity : hint_range(0.5, 3.0) = 1.5;
uniform float corona_strength : hint_range(0.0, 1.0) = 0.4;
uniform vec3 color_core : source_color = vec3(1.0, 0.98, 0.9);
uniform vec3 color_hot : source_color = vec3(1.0, 0.85, 0.3);
uniform vec3 color_mid : source_color = vec3(1.0, 0.5, 0.1);
uniform vec3 color_edge : source_color = vec3(0.9, 0.2, 0.05);
uniform vec3 color_outer : source_color = vec3(0.5, 0.08, 0.02);

// === BRUIT ===
vec3 mod289_3(vec3 x) {
	return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec4 mod289_4(vec4 x) {
	return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec4 permute(vec4 x) {
	return mod289_4(((x * 34.0) + 1.0) * x);
}

float noise(vec3 p) {
	vec3 a = floor(p);
	vec3 d = p - a;
	d = d * d * (3.0 - 2.0 * d);

	a = mod289_3(a);
	vec4 b = a.xxyy + vec4(0.0, 1.0, 0.0, 1.0);
	vec4 k1 = permute(b.xyxy);
	vec4 k2 = permute(k1.xyxy + b.zzww);

	vec4 c = k2 + a.zzzz;
	vec4 k3 = permute(c);
	vec4 k4 = permute(c + 1.0);

	vec4 o1 = fract(k3 * (1.0 / 41.0));
	vec4 o2 = fract(k4 * (1.0 / 41.0));
	vec4 o3 = o2 * d.z + o1 * (1.0 - d.z);
	vec2 o4 = o3.yw * d.x + o3.xz * (1.0 - d.x);

	return o4.y * d.y + o4.x * (1.0 - d.y);
}

float fbm(vec3 p) {
	float value = 0.0;
	float amplitude = 0.5;
	for (int i = 0; i < 5; i++) {
		value += amplitude * noise(p);
		p *= 2.01;
		amplitude *= 0.5;
	}
	return value;
}

// === FRAGMENT ===
void fragment() {
	vec2 uv = UV - 0.5;
	float dist = length(uv);
	float angle = atan(uv.y, uv.x);
	float t = TIME * speed;

	// 3 couches de bruit pour les flammes
	float n1 = fbm(vec3(angle * 3.0, dist * 4.0 - t * 2.0, t * 0.7)) * 0.5 + 0.5;
	float n2 = fbm(vec3(angle * 5.0 + 10.0, dist * 6.0 - t * 3.0, t * 1.1)) * 0.5 + 0.5;
	float n3 = fbm(vec3(angle * 8.0 + 20.0, dist * 8.0 - t * 4.0, t * 1.5)) * 0.5 + 0.5;

	float flame_edge = flame_size + flame_height * (n1 * 0.5 + n2 * 0.3 + n3 * 0.2);
	float flame = 1.0 - smoothstep(flame_size * 0.5, flame_edge, dist);

	float core_glow = exp(-dist * dist / (flame_size * flame_size * 0.8)) * core_intensity;
	float corona = exp(-max(0.0, dist - flame_size) * 8.0) * corona_strength * (0.3 + 0.2 * n1);
	float outer_glow = exp(-max(0.0, dist - flame_edge) * 5.0) * 0.15 * n2;

	// Gradient de température
	float temp = flame * (0.6 + 0.4 * n1);
	vec3 col = mix(color_outer, color_edge, smoothstep(0.0, 0.25, temp));
	col = mix(col, color_mid, smoothstep(0.25, 0.5, temp));
	col = mix(col, color_hot, smoothstep(0.5, 0.75, temp));
	col = mix(col, color_core, smoothstep(0.75, 1.0, temp));

	col = col * (flame + corona) + color_outer * outer_glow;
	col += color_core * core_glow * 0.8;
	col += vec3(1.0, 0.6, 0.2) * corona * 0.5;

	float flicker = 0.95 + 0.05 * sin(t * 15.0 + angle * 3.0);
	col *= flicker;
	col = 1.0 - exp(-col * 1.5);

	// En blend_add, l'alpha contrôle l'intensité de l'addition
	float alpha = min(1.0, (flame + corona + outer_glow) * 2.0);

	// Masque circulaire pour éviter le carré
	float circle_mask = 1.0 - smoothstep(0.3, 0.48, dist);
	alpha *= circle_mask;
	col *= circle_mask;

	COLOR = vec4(col, alpha);
}
"

