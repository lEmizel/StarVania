[sub_resource type="Shader" id="Shader_1af6x"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;
uniform float blur_amount : hint_range(0.0, 10.0) = 3.0;
uniform int iterations : hint_range(1, 10) = 5;

void fragment() {
	vec2 pixel_size = SCREEN_PIXEL_SIZE;
	vec4 color = vec4(0.0);
	float total_weight = 0.0;
	
	for (int x = -iterations; x <= iterations; x++) {
		for (int y = -iterations; y <= iterations; y++) {
			float weight = exp(-float(x * x + y * y) / (2.0 * blur_amount * blur_amount));
			color += textureLod(SCREEN_TEXTURE, SCREEN_UV + vec2(float(x), float(y)) * pixel_size * blur_amount, 0.0) * weight;
			total_weight += weight;
		}
	}
	
	COLOR = color / total_weight;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vmt6a"]
