[sub_resource type="Shader" id="Shader_hverl"]
code = "shader_type canvas_item;

uniform float speed : hint_range(0.0, 5.0) = 1.0;
uniform float density : hint_range(1.0, 200.0) = 80.0;
uniform float brightness : hint_range(0.5, 5.0) = 2.0;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float star(vec2 uv, float t) {
	vec2 id = floor(uv);
	vec2 f = fract(uv) - 0.5;
	
	float r = hash(id);
	float r2 = hash(id + 100.0);
	float r3 = hash(id + 200.0);
	
	vec2 offset = vec2(r, r2) - 0.5;
	float d = length(f - offset);
	
	float twinkle_speed = 2.0 + r3 * 6.0;
	float twinkle = sin(t * twinkle_speed + r * 6.2831) * 0.5 + 0.5;
	twinkle = mix(0.2, 1.0, twinkle);
	
	float size = 0.01 + r3 * 0.025;
	float s = smoothstep(size, 0.0, d) * twinkle;
	
	return s;
}

void fragment() {
	vec2 uv = UV;
	float t = TIME * speed;
	
	float stars = 0.0;
	
	stars += star(uv * density, t);
	stars += star(uv * density * 1.4 + 50.0, t * 1.3);
	stars += star(uv * density * 2.0 + 150.0, t * 0.7);
	stars += star(uv * density * 3.0 + 300.0, t * 1.1) * 0.6;
	stars += star(uv * density * 4.5 + 500.0, t * 0.9) * 0.4;
	
	float warm = hash(floor(uv * density));
	vec3 star_color = mix(vec3(0.7, 0.8, 1.0), vec3(1.0, 0.9, 0.7), warm);
	
	vec3 col = stars * star_color * brightness;
	COLOR = vec4(col, stars);
}"

