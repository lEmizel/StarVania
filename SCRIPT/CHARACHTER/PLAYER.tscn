[sub_resource type="Shader" id="Shader_ijyow"]
code = "shader_type canvas_item;

// Couleur a remplacer : #3CD738
uniform vec4 target_color : source_color = vec4(0.235, 0.843, 0.22, 1.0);
// Tolerance de detection (0 = couleur exacte uniquement)
uniform float tolerance : hint_range(0.0, 1.0) = 0.15;

// Fond bleu fonce
uniform vec4 background_color : source_color = vec4(0.02, 0.04, 0.18, 1.0);
// Couleur du noise par-dessus le fond
uniform vec4 noise_color : source_color = vec4(0.15, 0.3, 0.7, 1.0);

uniform sampler2D noise_texture : repeat_enable, filter_linear;
uniform float noise_scale : hint_range(0.1, 10.0) = 2.0;
// Vitesse de defilement du noise (mettre a 0,0 pour un noise fixe)
uniform vec2 noise_speed = vec2(0.05, 0.03);

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	float dist = distance(tex.rgb, target_color.rgb);

	if (dist < tolerance) {
		float n = texture(noise_texture, UV * noise_scale + noise_speed * TIME).r;
		COLOR = vec4(mix(background_color.rgb, noise_color.rgb, n), tex.a);
	} else {
		COLOR = tex;
	}
}
"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_1"]
frequency = 0.02

[sub_resource type="NoiseTexture2D" id="NoiseTexture2D_1"]
noise = SubResource("FastNoiseLite_1")
seamless = true

[sub_resource type="ShaderMaterial" id="ShaderMaterial_2uwbu"]
shader = SubResource("Shader_ijyow")
shader_parameter/target_color = Color(1, 0.9411765, 0.4745098, 1)
shader_parameter/tolerance = 0.52800002508
shader_parameter/background_color = Color(1, 1, 1, 1)
shader_parameter/noise_color = Color(1, 1, 1, 1)
shader_parameter/noise_texture = SubResource("NoiseTexture2D_1")
shader_parameter/noise_scale = 0.45600001840012
shader_parameter/noise_speed = Vector2(0, 0)

