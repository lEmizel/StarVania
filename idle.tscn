[sub_resource type="Shader" id="Shader_bttnf"]
code = "shader_type canvas_item;

uniform vec4 color_from : source_color = vec4(0.73, 0.19, 0.30, 1.0); // BA4C60
uniform vec4 color_to : source_color = vec4(0.44, 0.19, 0.30, 1.0);   // 70314C
uniform float hue_shift : hint_range(0.0, 1.0) = 0.0;
uniform float saturation : hint_range(0.0, 2.0) = 1.0;
uniform float brightness : hint_range(0.5, 1.5) = 1.0;
uniform float hue_tolerance : hint_range(0.01, 0.3) = 0.06;

vec3 rgb2hsv(vec3 c) {
	vec4 K = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	float e = 1.0e-10;
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
	vec4 K = vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
	vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
	return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	vec3 hsv = rgb2hsv(tex.rgb);

	// Calculer le hue cible = milieu entre les deux couleurs source
	float hue_from = rgb2hsv(color_from.rgb).x;
	float hue_to = rgb2hsv(color_to.rgb).x;
	float target_hue = (hue_from + hue_to) * 0.5;

	float dist = abs(hsv.x - target_hue);
	dist = min(dist, 1.0 - dist);

	if (dist < hue_tolerance && hsv.y > 0.1) {
		hsv.x = fract(hsv.x + hue_shift);
		hsv.y *= saturation;
		hsv.z *= brightness;
	}

	COLOR = vec4(hsv2rgb(hsv), tex.a);
}"

